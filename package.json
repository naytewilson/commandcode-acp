{
  "name": "commandcode-acp",
  "version": "0.1.0",
  "description": "Thin ACP v1 stdio bridge for the Command Code CLI (cmd -p --output-format json). Shared integration boundary for Paseo and T3 Code.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "commandcode-acp": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "probe": "node ./dist/index.js --probe"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.7.4"
  },
  "license": "UNLICENSED",
  "private": true
}
